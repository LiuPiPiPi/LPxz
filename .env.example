# 单容器对外端口（宿主机 -> 容器 80，nginx 统一入口）
WEB_PORT=8080
# 数据持久化目录（挂载到容器 /app/instance 与 /app/backups）
LPXZ_DATA_DIR=/var/lib/lpxz

# Flask 运行时配置
FLASK_ENV=production
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=8090
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# 本地开发用相对路径（相对 lpxz_api/），落在 lpxz_api/instance 与 lpxz_api/backups。
# Docker 下由 docker-compose.yml 的 environment 覆盖为容器内 /app/instance 与 /app/backups。
SQLITE_DATABASE=instance/lpxz.sqlite3
SQLITE_BACKUP_DIR=backups
ENABLE_SCHEDULER=true
# 前端与 API 同源，通常无需 CORS；如需跨域调试再添加来源
CORS_ALLOWED_ORIGINS=

# 前端构建参数（构建时读取）。单容器 Docker 构建使用 Dockerfile 内的 ARG 默认值：
#   前台 Vue       -> VUE_APP_API_BASE_URL=/api/   （公开接口）
#   管理面板 React -> REACT_APP_API_BASE_URL=/admin/ （管理接口，含登录）
# 分域名部署（如 https://api.lpxz.work）时改为绝对地址后重新构建。
VUE_APP_API_BASE_URL=/api/
VUE_APP_NAME=prod
VUE_APP_DEFAULT_LOGIN_USERNAME=
REACT_APP_API_BASE_URL=/admin/
REACT_APP_SITE_URL=/

# 本地前端开发（npm run serve / npm start）如需指向本地后端 8090，
# 在 lpxz_view/ 或 lpxz_cms/ 下新建 .env.local（已被 git 忽略）写入本地地址，例如：
#   lpxz_view/.env.local  -> VUE_APP_API_BASE_URL=http://localhost:8090/
#   lpxz_cms/.env.local   -> REACT_APP_API_BASE_URL=http://localhost:8090/admin/
